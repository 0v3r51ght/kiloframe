{
  "servers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "serena": {
      "command": "serena",
      "args": ["start-mcp-server"],
      "enabled": true
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@github/github-mcp-server"],
      "env": {"GITHUB_PERSONAL_ACCESS_TOKEN": ""},
      "enabled": false
    },
    "exa": {
      "command": "npx",
      "args": ["-y", "exa-mcp-server"],
      "env": {"EXA_API_KEY": ""},
      "enabled": false
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {"FIRECRAWL_API_KEY": "", "FIRECRAWL_API_URL": "https://api.firecrawl.dev"},
      "enabled": false
    }
  }
}
