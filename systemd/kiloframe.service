[Unit]
Description=KiloFrame local-first AI daemon
Documentation=https://github.com/0v3r51ght/kiloframe
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kiloframe
Group=kiloframe
Environment=PYTHONPATH=/opt/kiloframe/app/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m kiloframe.daemon
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0
TimeoutStartSec=120
TimeoutStopSec=60
KillMode=mixed
RuntimeDirectory=kiloframe
RuntimeDirectoryMode=0750
StateDirectory=kiloframe
StateDirectoryMode=0750
LogsDirectory=kiloframe
LogsDirectoryMode=0750
UMask=0027
NoNewPrivileges=false
PrivateDevices=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=false
LockPersonality=true

[Install]
WantedBy=multi-user.target
